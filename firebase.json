    },
    "ui": {
      "enabled": true,
      "port": 4000
    }
  },
  "apphosting": {
    "backendId": "internship-dashboard",
    "rootDir": "/",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "functions"
    ]
  }
